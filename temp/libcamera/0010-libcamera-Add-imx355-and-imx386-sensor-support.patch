From: Simon <m8l8th814n@gmail.com>
Date: Sun, 20 Sep 2026 20:10:00 +0200
Subject: [PATCH 10/10] libcamera: Add imx355 and imx386 sensor support for gs101

Add camera sensor helpers for imx355 (Pixel 6 front) and imx386 (rear
ultra-wide): Sony analogue gain 1024 / (1024 - code), black level 0x40 at
10 bits, and their static properties, which the software ISP AGC needs.
Both are ordinary Bayer sensors (the quad-Bayer entry for imx355 gave a
green cell-collapsed image and is gone, pkgrel 9).
---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -617,6 +617,31 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx335", CameraSensorHelperImx335)
 
+class CameraSensorHelperImx355 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx355()
+	{
+		/* 0x40 at 10 bits, as the upstream imx355 tuning file assumes. */
+		blackLevel_ = 4096;
+		/* Sony analogue gain code, 1024 / (1024 - code); kernel driver max 960 = 16x. */
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx355", CameraSensorHelperImx355)
+
+class CameraSensorHelperImx386 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx386()
+	{
+		/* Same register semantics as imx355 in the kernel driver (ANA_GAIN_MAX 960). */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx386", CameraSensorHelperImx386)
+
 class CameraSensorHelperImx415 : public CameraSensorHelper
 {
 public:
diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -261,6 +261,16 @@
 			.testPatternModes = {},
 			.sensorDelays = { },
 		} },
