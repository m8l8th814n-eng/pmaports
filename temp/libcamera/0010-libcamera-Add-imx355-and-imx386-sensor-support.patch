+			.unitCellSize = { 1120, 1120 },
+			.testPatternModes = {},
+			.sensorDelays = { },
+		} },
+		{ "imx386", {
+			.unitCellSize = { 1250, 1250 },
+			.testPatternModes = {},
+			.sensorDelays = { },
+		} },
 		{ "imx415", {
 			.unitCellSize = { 1450, 1450 },
 			.testPatternModes = {},
