maintainer="Ingo Reitz <9l@9lo.re>"
pkgname=linux-postmarketos-gs101
pkgver=7.2.0_rc3
pkgrel=0
pkgdesc="Google gs101 (Pixel 6 Series) close-to-mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-gs101"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bison
	clang
	findutils
	flex
	lld
	llvm
	lz4
	openssl-dev
	perl
	python3
	zstd
"

# Source
_commit="d28cfa4275b95e93f4b7a1e743de31b723bd21b8"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/gs101-mainline/linux/archive/$_commit.tar.gz
	$_config
	0001-drm-panfrost-add-Mali-G78-gs101-GPU-ID-0x9202.patch
"
builddir="$srcdir/linux-$_commit"
_outdir="out"

_aoc_config="
	CONFIG_WC_MBOX=m
	CONFIG_AOC_DRIVER=m
	CONFIG_AOC_CHAR_DRIVER=m
	CONFIG_AOC_CONTROL_DRIVER=m
	CONFIG_AOC_CHAN_DRIVER=m
"

# gs101 declares "samsung,sysmmu-v8" throughout its device tree; the v9
# driver is for gs201/zuma and is not built.
_gsa_config="
	CONFIG_GSA=m
"

_sensor_config="
	CONFIG_GPIO_REGMAP=y
	CONFIG_GPIO_S2MPG1X=y
	CONFIG_REGULATOR_SLG51000=m
	CONFIG_VL53L1X_I2C=m
"

_edgetpu_config="
	CONFIG_EDGETPU_FRAMEWORK=m
	CONFIG_ABROLHOS=m
"

_iommu_config="
	CONFIG_SAMSUNG_IOMMU=m
	CONFIG_SAMSUNG_IOMMU_GROUP=m
"

# Trusty (secure-world transport). Stock Trusty is resident behind ABL and
# answers SMCs (trusty_probe: api v5, "slider"). Port the normal-world driver
# to reach it so AoC's SPEECH_INIT secure dependency can be restored.
# CONFIG_TRUSTY_IRQ is =y because trusty-irq.o is linked into trusty-core.
_trusty_config="
	CONFIG_TRUSTY=m
	CONFIG_TRUSTY_IRQ=y
	CONFIG_TRUSTY_LOG=m
	CONFIG_TRUSTY_VIRTIO=m
	CONFIG_TRUSTY_VIRTIO_IPC=m
"

# GSC / Titan-M2 (google,gsc) SPI driver -> /dev/gsc0 (libnos/citadel_updater).
_gsc_config="
	CONFIG_GSC=m
"

# Samsung s5123 modem (cpif). The modem hangs off PCIe channel 0 and is
# booted over SPI bus 9, so nothing appears on the bus until this driver
# releases it from reset. Trimmed: DIT, BTL, the throughput monitor,
# direct DM and the vendor hooks are all left out of modem/Kbuild.
# Broadcom BCM4775 GNSS on SPI5. Discrete receiver, not the integrated Kepler
# GNSS of zuma and later -- which is why fw_data[GnssType] is 0 on gs101.
_gps_config="
CONFIG_BCM_GPS_SPI_DRIVER=m
CONFIG_BCM_GPS_PPS_DRIVER=m
"

_modem_config="
	CONFIG_EXYNOS_MODEM_IF=m
	CONFIG_SHM_IPC=m
	CONFIG_BOOT_DEVICE_SPI=m
	CONFIG_SEC_MODEM_S5100=y
	CONFIG_LINK_DEVICE_PCIE=y
	CONFIG_LINK_DEVICE_WITH_SBD_ARCH=y
	CONFIG_CP_PKTPROC=y
	CONFIG_CP_PKTPROC_UL=y
"

# WIP DECON skeleton. Lives in the kernel tree proper, so unlike the
# out-of-tree modules above it needs its symbol in the config, not on the
# make command line.
_decon_config="CONFIG_DRM_GS101=m
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC3=m
CONFIG_DRM_SIMPLEDRM=n
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y"

# ST21NFC on USI7, driven by mainline's st-nci. NFC and NFC_NCI are already
# modules in the base config; only the ST transport is missing.
_nfc_config="CONFIG_NFC_ST_NCI=m
CONFIG_NFC_ST_NCI_I2C=m"

# console=null leaves a hang with nothing to look at. Route every printk into
# the ramoops buffer instead, built in rather than modular so it is armed from
# early boot, and read it back from /sys/fs/pstore after the next boot.
# The default 10s window closes before udev gets to the out-of-tree modules --
# switch_root alone lands at ~14s here -- so aoc, abrolhos and friends probe
# with their suppliers unfinished and silently swallow the -EPROBE_DEFER.
# brcmfmac's brcmf_dbg() is compiled out without this, so the msgbuf and PCIe
# traces are unavailable and brcmfmac.debug= does nothing.
_brcmdbg_config="CONFIG_BRCMDBG=y
CONFIG_BRCM_TRACING=y"

_probe_config="CONFIG_DRIVER_DEFERRED_PROBE_TIMEOUT=30"

_pstore_config="CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config

	# Migrate the config to the kernel version in $builddir. Must use LLVM=1
	# like build()/package(), else clang-only symbols (CFI_CLANG,
	# SHADOW_CALL_STACK, LTO_CLANG_*) get silently dropped.
	unset LDFLAGS

	# Append before olddefconfig so dependencies get resolved.
	echo "$_decon_config" >> .config
	echo "$_nfc_config" >> .config
	echo "$_pstore_config" >> .config
	echo "$_probe_config" >> .config
	echo "$_brcmdbg_config" >> .config
	echo "$_sensor_config" >> .config

	make ARCH="$_carch" LLVM=1 olddefconfig

	if ! grep -q "^CONFIG_DRM_GS101=" .config; then
		error "CONFIG_DRM_GS101 was dropped by olddefconfig"
		return 1
	fi

	if ! grep -q "^# CONFIG_DRM_SIMPLEDRM is not set" .config; then
		error "CONFIG_DRM_SIMPLEDRM survived olddefconfig"
		return 1
	fi
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	if [ -d "$builddir/bcmdhd" ]; then
		make -C "$builddir" M="$builddir/bcmdhd" \
			BCMDHD_ROOT="$builddir/bcmdhd" modules \
			ARCH="$_carch" LLVM=1
	fi

	if [ -d "$builddir/gsa" ]; then
		make -C "$builddir" M="$builddir/gsa" modules \
			ARCH="$_carch" LLVM=1 \
			$_gsa_config
	fi

	# AoC (Always-on Compute) coprocessor: audio lives behind it. The
	# CONFIG_AOC_* symbols are passed on the command line because aoc/Kconfig
	# is not sourced from the main kernel Kconfig tree. AoC calls into GSA,
	# so it needs GSA's symbols and GSA has to be built first.
	# Trusty must build before aoc: aoc.c now calls the trusty ipc client
	# (tipc_*) to program AoC SSMT, so it needs trusty's Module.symvers.
	if [ -d "$builddir/trusty" ]; then
		make -C "$builddir" M="$builddir/trusty" modules \
			ARCH="$_carch" LLVM=1 \
			$_trusty_config
	fi

	if [ -d "$builddir/aoc" ]; then
		make -C "$builddir" M="$builddir/aoc" modules \
			ARCH="$_carch" LLVM=1 \
			KBUILD_EXTRA_SYMBOLS="$builddir/gsa/Module.symvers $builddir/trusty/Module.symvers" \
			$_aoc_config
	fi

	if [ -d "$builddir/cs35l41dna" ]; then
		make -C "$builddir" M="$builddir/cs35l41dna" modules \
			ARCH="$_carch" LLVM=1
	fi

	if [ -d "$builddir/edgetpu" ]; then
		make -C "$builddir" M="$builddir/edgetpu" modules \
			ARCH="$_carch" LLVM=1 \
			KBUILD_EXTRA_SYMBOLS="$builddir/gsa/Module.symvers" \
			$_edgetpu_config
	fi

	# Samsung SysMMU v9. AoC cannot get an iommu domain without it.
	if [ -d "$builddir/samsung-iommu" ]; then
		make -C "$builddir" M="$builddir/samsung-iommu" modules \
			ARCH="$_carch" LLVM=1 \
			$_iommu_config
	fi

	if [ -d "$builddir/modem" ]; then
		make -C "$builddir" M="$builddir/modem" modules \
			ARCH="$_carch" LLVM=1 \
			$_modem_config
	fi

	if [ -d "$builddir/gps" ]; then
		make -C "$builddir" M="$builddir/gps" modules \
			ARCH="$_carch" LLVM=1 \
			$_gps_config
	fi

	# Trusty presence probe (diagnostic): plain module, only uses arm_smccc.
	if [ -d "$builddir/trusty-probe" ]; then
		make -C "$builddir" M="$builddir/trusty-probe" modules \
			ARCH="$_carch" LLVM=1
	fi


	# GSC / Titan-M2 SPI driver (google,gsc on spi_10).
	if [ -d "$builddir/gsc" ]; then
		make -C "$builddir" M="$builddir/gsc" modules \
			ARCH="$_carch" LLVM=1 \
			$_gsc_config
	fi
}

package() {
	mkdir -p "$pkgdir"/boot

	make Image.lz4 modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	if [ -d "$builddir/bcmdhd" ]; then
		make -C "$builddir" M="$builddir/bcmdhd" \
			BCMDHD_ROOT="$builddir/bcmdhd" modules_install \
			ARCH="$_carch" LLVM=1 \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/gsa" ]; then
		make -C "$builddir" M="$builddir/gsa" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_gsa_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/edgetpu" ]; then
		make -C "$builddir" M="$builddir/edgetpu" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_edgetpu_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/aoc" ]; then
		make -C "$builddir" M="$builddir/aoc" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_aoc_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/cs35l41dna" ]; then
		make -C "$builddir" M="$builddir/cs35l41dna" modules_install \
			ARCH="$_carch" LLVM=1 \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/samsung-iommu" ]; then
		make -C "$builddir" M="$builddir/samsung-iommu" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_iommu_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/modem" ]; then
		make -C "$builddir" M="$builddir/modem" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_modem_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/gps" ]; then
		make -C "$builddir" M="$builddir/gps" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_gps_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/trusty-probe" ]; then
		make -C "$builddir" M="$builddir/trusty-probe" modules_install \
			ARCH="$_carch" LLVM=1 \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/trusty" ]; then
		make -C "$builddir" M="$builddir/trusty" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_trusty_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi

	if [ -d "$builddir/gsc" ]; then
		make -C "$builddir" M="$builddir/gsc" modules_install \
			ARCH="$_carch" LLVM=1 \
			$_gsc_config \
			INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1
	fi
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	install -Dm644 "$builddir/arch/$_carch/boot/Image.lz4" \
		"$pkgdir/boot/vmlinuz"
}

