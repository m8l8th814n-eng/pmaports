maintainer="Ingo Reitz <9l@9lo.re>"
pkgname=device-google-oriole
pkgdesc="Google Pixel 6"
pkgver=6
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools
	linux-postmarketos-gs101
	postmarketos-base
	soc-google-gs101
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	aoc-trusty.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Trusty stack load order before aoc_core (secure-world bring-up for AoC).
	install -Dm644 "$srcdir"/aoc-trusty.conf \
		"$pkgdir"/etc/modprobe.d/aoc-trusty.conf
}

